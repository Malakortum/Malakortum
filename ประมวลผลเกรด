total = 0

a = int(input("กรุณากรอกคะแนนเก็บ: "))
if a < 0:
    print("กรุณากรอกอีกครั้ง")
elif a > 30:
    print("กรุณากรอกอีกครั้ง")
else:
    total += a
    
b = int(input("กรุณากรอกคะแนนกลางภาค: "))
if b < 0:
    print("กรุณากรอกอีกครั้ง")
elif b > 30:
    print("กรุณากรอกอีกครั้ง")
else:
    total += b

c = int(input("กรุณากรอกคะแนนปลายภาค: "))
if c < 0:
    print("กรุณากรอกอีกครั้ง")
elif c > 40:
    print("กรุณากรอกอีกครั้ง")
else:
    total += c
    
if total in range(60 , 65):
    print("C")
elif total in range(65 , 70):
    print("C+")
elif total in range(70 , 75):
    print("B")
elif total in range(75 , 80):
    print("B+")
elif total in range(80 , 101):
    print("A")
else:
    print("F")
