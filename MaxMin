max_val = None
min_val = None
total = 0
count = 0

while True:
    line = input()
    if line == "":
        break
    
    num = float(line)
    
    if max_val is None or num > max_val:
        max_val = num
    if min_val is None or num < min_val:
        min_val = num
    
    total += num
    count += 1

avg = total / count

print(f"{max_val:.2f} {min_val:.2f}")
print(f"{total:.2f} {avg:.2f}")


