#ฐานนิยมจงเขียนโปรแกรมเพื่อรับคะแนนสอบย่อย (คะแนนเต็ม 10 ไม่มีคะแนนติดลบ) ของนักเรียนจำนวน 20 คน
#มาสร้างเป็น list แล้วแสดงผลฐานนิยม (mode–จำนวนในรายการที่มีความถี่สูงที่สุด) ของ list ดังกล่าว
#หมายเหตุ ให้แสดงข้อความแจ้งข้อความโต้ตอบหรือข้อผิดพลาดที่อาจเกิดขึ้นในกรณีต่างๆ ดังนี้
#“Score is out of range.” เมื่อคะแนนไม่อยู่ในช่วง 0 – 10
#กำหนดให้มีฟังก์ชัน find_mode(l) เพื่อแสดงผลฐานนิยมของ list l
#ในกรณีที่มีจำนวนที่มีความถี่สูงสุดเท่ากันมากกว่า 1 จำนวน จำนวนเหล่านั้นทุกจำนวนเป็นฐานนิยม
#โดยให้แสดงผลลัพธ์จากน้อยไปหามาก บรรทัดละ 1 จำนวน

def fine_mode(l):
    max_c = max(l.count(x) for x in l)
    mode = []
    for x in l:
        if l.count(x) == max_c and x not in mode:
            mode.append(x)
    mode.sort()
    return mode

l = []
i = 0
while i <20:
    s = int(input("Enter score: "))
    if s < 0 or s > 10:
        print("Score is out of range.")
        continue
    else:
        i += 1
        l.append(s)
        l.sort()
    if i == 20:
        print("-----")
        print("Original list:")
        print(l)
        print("Mode of scores:")
        for m in fine_mode(l):
            print(m)
